# Credenciales ficticias para el PostgreSQL local de Docker Compose.
POSTGRES_USER=demo
POSTGRES_PASSWORD=demo_local_only
POSTGRES_DB=integration_demo

# Puertos publicados en la máquina local.
INTEGRATION_PORT=3000
EXTERNAL_API_PORT=3001
POSTGRES_PORT=5432

# Opcionales para ejecutar los comandos de presentación desde otra máquina.
INTEGRATION_URL=http://localhost:3000
EXTERNAL_API_URL=http://localhost:3001
